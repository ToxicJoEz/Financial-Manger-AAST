# Local development only. Do not commit .env.
DATABASE_URL="file:./dev.db"
PORT=5000
JWT_SECRET=
# Optional: must match the SSO portal's SSO_JWT_SECRET to enable SSO.
SSO_JWT_SECRET=
# Bcrypt hash used only to initialize main-admin. Generate privately.
MAIN_ADMIN_PASSWORD_HASH=
# Optional recipient check: portal must issue the matching audience before enabling.
SSO_AUDIENCE=
