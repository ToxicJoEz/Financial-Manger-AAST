generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String?
  role      String   @default("user") // 'user', 'mod', 'admin'
  email     String?
  firstName String?
  lastName  String?
  avatar    String?
  isActive  Boolean  @default(true)
  isBanned  Boolean  @default(false)
  lastLogin DateTime?
  canManageBooks Boolean @default(false)
  // Users only: can enter placement test results (the Tests tab). Set by admins and the main mod.
  canPlacementTest Boolean @default(false)
  // Mods only: null = main mod (all branches, payroll); a branch (e.g. FOUAD) = branch mod whose money is checked.
  branchScope String?
  // Users (role "user") see only these branches (comma-separated); none means nothing until assigned.
  branches String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  submittedAssignments PendingAssignment[] @relation("SubmittedAssignments")
  resolvedAssignments  PendingAssignment[] @relation("ResolvedAssignments")
  notifications        Notification[]
}

model SystemLog {
  id             String   @id @default(uuid())
  action         String
  description    String
  actorUsername  String
  targetUsername String?
  createdAt      DateTime @default(now())

  actorId        String?
  actorRole      String?
  authMethod     String?
  category       String   @default("system")
  outcome        String   @default("SUCCESS")
  requestId      String?  @unique
  statusCode     Int?
  durationMs     Int?
  recordCount    Int      @default(0)
  details        Json?
  // Failures: what kind (INVALID_INPUT, NOT_ALLOWED, BLOCKED_BY_RULE, UNEXPECTED, ...) and the exact reason.
  errorKind      String?
  errorMessage   String?

  @@index([createdAt, id])
  @@index([actorRole, createdAt])
  @@index([actorUsername, createdAt])
  @@index([category, outcome, createdAt])
  @@index([errorKind, createdAt])
}

model Instructor {
  id         String   @id @default(uuid())
  name       String
  branches   String   // Stored as a comma-separated string (e.g., "MIAMI,FOUAD")
  employeeId String? @unique  // Employee ID
  mobile     String?  // Mobile Number
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  archivedAt DateTime?
  archivedBy String?
  payrollEarnings PayrollEarning[]
  courseAssignments  CourseInstructor[]
  pendingAssignments PendingAssignment[]
}

// Umbrella: no branch, teaching defaults, enrollment, or financial state. Umbrellas sit in one of two fixed
// sections: Group (each has a unique course code) or Private (no code). Cycles sit directly under an umbrella.
model Course {
  isPrivate Boolean @default(false)
  id String @id @default(uuid())
  name String
  code String? @unique
  bookPrice Int @default(0) // piasters
  // Branches allowed to run cycles under this umbrella (comma-separated). New umbrellas open for Miami only.
  branches String @default("MIAMI")
  archivedAt DateTime?
  archivedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cycles Cycle[]
}

model Cycle {
  parentCourseId String
  parentCourse Course @relation(fields: [parentCourseId], references: [id], onDelete: Restrict)
  // The umbrella the cycle is named and numbered after (its id).
  numberingKey String
  // The level the mod enters (1 and up). Name: "<umbrella> <level> - <start month> <year>", plus " (n)" when the
  // same branch already runs that level in that month (sequence n).
  // Empty for exam umbrellas (IELTS, CEPT, TOEFL, PTE) when the cycle has no level: "IELTS - November 2026".
  cycleNumber Int?
  sequence    Int @default(1)
  // Cycles created by branch mods wait for the main mod: PENDING, then APPROVED (locked for branch mods) or
  // REJECTED (archived). Cycles made by admins and the main mod are approved at once.
  approvalStatus  String    @default("APPROVED")
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  // Levels taken one after another (KET 1 -> KET 2): same umbrella and same branch.
  // chainId is the first cycle of the chain and chainStart its start date, so a chain lists together.
  previousCycleId String?
  previousCycle   Cycle?  @relation("NextLevel", fields: [previousCycleId], references: [id], onDelete: SetNull)
  nextCycles      Cycle[] @relation("NextLevel")
  chainId         String?
  chainStart      DateTime?

  id           String   @id @default(uuid())
  // Who created the cycle. A branch mod can only change cycles they created, until the main mod checks its money.
  createdById  String?
  name         String
  venue        String?
  classStartTime String? // Local class time HH:mm
  classEndTime   String? // Local class time HH:mm
  details      String?
  branch       String
  startDate    DateTime?
  endDate      DateTime?
  isFinished   Boolean  @default(false)
  totalHours   Float?   // Set when course is created or finished
  courseFee    Int      @default(0) // Standard tuition fee, in piasters
  payrollMonth String?  // Legacy migration-only; current earnings have no payroll month.
  isPaid       Boolean  @default(false) // Legacy migration-only; use earning batches. 
  archivedAt   DateTime?
  archivedBy   String?
  payrollRecord PayrollRecord?
  payrollEarnings PayrollEarning[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructors  CourseInstructor[]
  pendingAssignments PendingAssignment[]
  retainedIncome RetainedEnrollmentIncome[]
  enrollments  Enrollment[]

  @@unique([numberingKey, branch, name])
  @@index([approvalStatus])
  @@index([parentCourseId, archivedAt])
  @@index([chainId])
  @@index([createdById])
}

model CourseInstructor {
  id           String     @id @default(uuid())
  courseId     String
  instructorId String
  hourlyRate   Int        // The rate for this instructor in this course, in piasters
  hoursTaught  Float?     // Filled when the course is finished, or when this employee's hours are closed early
  // Hours closed before the course ends (e.g. 15 of 20, with another employee finishing the rest). Closed hours
  // are fixed and already in payroll as unpaid earnings.
  closedAt     DateTime?
  closedBy     String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course       Cycle     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId])
}

model PendingAssignment {
  id              String   @id @default(uuid())
  courseId        String
  instructorId    String?  // null if requesting removal
  submittedById   String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  type            String   @default("ASSIGN")  // ASSIGN, REMOVE, REPLACE, CLOSE_HOURS
  hours           Float?   // CLOSE_HOURS: the hours to close the employee at
  replacedAssignmentId String?
  replacedInstructorId String?
  resolvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Cycle      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor      Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  submittedBy     User        @relation("SubmittedAssignments", fields: [submittedById], references: [id], onDelete: Cascade)
  resolvedBy      User?       @relation("ResolvedAssignments", fields: [resolvedById], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Recipient
  title       String
  message     String
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedBy  String?  // Name of the mod/admin who resolved it
  type        String   // 'ASSIGNMENT_REQUEST', 'ASSIGNMENT_APPROVED', 'ASSIGNMENT_REJECTED'
  relatedId   String?  // ID of the PendingAssignment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BranchColor {
  name  String @id
  color String
}

model Student {
  id                 String       @id @default(uuid())
  name               String
  englishName        String?
  dateOfBirth        DateTime?
  nationality        String?
  placeOfBirth       String?
  registrationNumber String?      @unique
  mobile             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  deletedBy          String?

  enrollments        Enrollment[]
  placementTests     PlacementTest[]
}

// A placement test result entered by the testing office: the score and the level they recommend. The student is
// "placed" as soon as they are enrolled in any cycle after the test (worked out, not stored).
model PlacementTest {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  branch      String
  // Filled in by the testing office: the score (out of 55), the level they recommend and the test's purpose
  // (General English, IELTS, TOEFL, PTE). Empty while the test waits for its result.
  score       Float?
  level       String?
  purpose     String?
  resultBy    String?
  resultAt    DateTime?
  testedAt    DateTime @default(now())
  // Who created the test (admins and the main mod).
  enteredById String?
  enteredBy   String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([branch])
}

model Enrollment {
  id         String   @id @default(uuid())
  courseId   String
  studentId  String
  amountPaid Int      @default(0) // piasters
  customFee  Int?     // piasters; if set, overrides the cycle fee for this student (0 = exempt)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookPayments BookPayment[]
  payments   PaymentEntry[]
  deletedAt  DateTime?
  deletedBy  String?
  financialArchivedAt DateTime?

  course     Cycle   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// Legacy snapshots retained for migration and historical compatibility only.
// Current payroll uses PayrollEarning and InstructorPaymentBatch.
model PayrollRecord {
  id           String @id @default(uuid())
  courseId     String @unique
  course       Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name         String
  branch       String
  totalHours   Float
  payrollMonth String?
  isPaid       Boolean @default(false)
  instructors  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([payrollMonth])
}

// Immutable tuition ledger. Amounts are signed integer piasters, never floating-point cash.
// Historical snapshots survive enrollment removal; correcting an entry adds another entry.
model PaymentEntry {
  id                String   @id @default(uuid())
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseId          String
  studentId         String
  courseName        String
  studentName       String
  amountMinor       BigInt
  kind              String
  note              String
  recordedBy        String
  recordedAt        DateTime @default(now())
  occurredAt        DateTime @default(now())
  idempotencyKey    String   @unique
  paymentMethod     String   @default("UNSPECIFIED")
  receiptNumber     String?
  paymentDateKnown  Boolean  @default(true)
  importBatchId     String?
  reversalOfId      String?  @unique
  reversalOf        PaymentEntry? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal          PaymentEntry? @relation("PaymentReversal")

  @@index([enrollmentId, recordedAt])
  @@index([courseId, occurredAt])
  @@index([studentId])
}


// Successful imports only. Source workbooks are not retained.
model ImportBatch {
  id String @id @default(uuid())
  fingerprint String @unique
  fileName String
  parentCourseId String
  cycleId String @unique
  recordedBy String
  createdAt DateTime @default(now())
  studentCount Int
}

model PayrollEarning {
  isPrivate Boolean @default(false)
  id String @id @default(uuid())
  courseId String
  course Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorId String
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  cycleName String
  branch String
  instructorName String
  employeeId String?
  hours Float
  rate Int // piasters per hour
  amountMinor BigInt
  batchId String?
  batch InstructorPaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([courseId, instructorId])
  @@index([instructorId, batchId])
}
// A payment batch as staff see it: "Payment batch 2 · October 2026". One initiation creates one run;
// numbers restart each initiation month and are never reused. Each employee's payment inside it is an
// InstructorPaymentBatch with its own status and actual payment date.
model PaymentRun {
  id String @id @default(uuid())
  year Int
  month Int
  number Int
  initiatedDate DateTime
  initiatedBy String?
  payments InstructorPaymentBatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([year, month, number])
}

model InstructorPaymentBatch {
  id String @id @default(uuid())
  runId String
  run PaymentRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  instructorId String
  instructorName String
  status String @default("PROCESSING")
  initiatedDate DateTime?
  actualPaymentDate DateTime?
  initiatedBy String?
  paidBy String?
  legacy Boolean @default(false)
  idempotencyKey String? @unique
  earnings PayrollEarning[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, initiatedDate])
  @@index([runId])
}

// Immutable purchase-time amounts; undo retains the original record.
model BookPayment {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activeKey String? @unique
  status String
  amountMinor BigInt
  recordedAt DateTime @default(now())
  recordedBy String
  reversedAt DateTime?
  reversedBy String?
  @@index([enrollmentId])
}

model RetainedEnrollmentIncome {
 id String @id @default(uuid())
 courseId String
 course Cycle @relation(fields:[courseId],references:[id],onDelete:Cascade)
 sourceEnrollmentId String @unique
 tuitionMinor BigInt
 bookMinor BigInt
 reason String
 snapshot Json
 recordedBy String
 createdAt DateTime @default(now())
 @@index([courseId])
}

// A main mod's (or admin's) confirmation that money recorded for a checked branch matches the paperwork.
// kind: PAYMENT (tuition ledger entry) or BOOK (book payment). The fingerprint captures the record when checked,
// so a later change shows as "changed after check".
model MoneyCheck {
  id          String   @id @default(uuid())
  kind        String
  recordId    String
  branch      String
  fingerprint String
  note        String?
  checkedBy   String
  checkedAt   DateTime @default(now())

  @@unique([kind, recordId])
  @@index([branch])
}

// Temporary storage while a backup file is downloaded or uploaded in parts (hosting limits each request's
// size). Never part of a backup; parts older than a few hours are cleared automatically.
model BackupTransfer {
  id          String        @id @default(uuid())
  kind        String        // DOWNLOAD or UPLOAD
  userId      String
  fileName    String
  size        Int
  totalChunks Int
  sha256      String?
  createdAt   DateTime      @default(now())
  chunks      BackupChunk[]
}

model BackupChunk {
  transferId String
  transfer   BackupTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  index      Int
  data       Bytes

  @@id([transferId, index])
}

// The academy's branches, managed by admins and the main mod. Data refers to a branch by its code (e.g. DOKKI),
// which never changes; the name and colour can. A deleted branch whose data was kept is renamed to
// <CODE>-DELETED and stays only as history (no new cycles, umbrellas or staff).
model Branch {
  code      String    @id
  name      String
  color     String
  sortOrder Int       @default(0)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
}
