generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String?
  role      String   @default("user") // 'user', 'mod', 'admin'
  email     String?
  firstName String?
  lastName  String?
  avatar    String?
  isActive  Boolean  @default(true)
  isBanned  Boolean  @default(false)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs      SystemLog[] @relation("ActorLogs")
  targetOf  SystemLog[] @relation("TargetLogs")

  submittedAssignments PendingAssignment[] @relation("SubmittedAssignments")
  resolvedAssignments  PendingAssignment[] @relation("ResolvedAssignments")
  notifications        Notification[]
}

model SystemLog {
  id             String   @id @default(uuid())
  action         String
  description    String
  actorUsername  String
  targetUsername String?
  createdAt      DateTime @default(now())

  actor          User     @relation("ActorLogs", fields: [actorUsername], references: [username], onDelete: Cascade)
  target         User?    @relation("TargetLogs", fields: [targetUsername], references: [username], onDelete: SetNull)
}

model Instructor {
  id         String   @id @default(uuid())
  name       String
  branches   String   // Stored as a comma-separated string (e.g., "MIAMI,FOUAD")
  employeeId String? @unique  // Employee ID
  mobile     String?  // Mobile Number
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  payrollEarnings PayrollEarning[]
  courseAssignments  CourseInstructor[]
  pendingAssignments PendingAssignment[]
}

// Umbrella: no branch, teaching defaults, enrollment, or financial state.
model Course {
  id String @id @default(uuid())
  name String
  code String @unique
  bookPrice Float @default(0)
  archivedAt DateTime?
  archivedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cycles Cycle[]
}

model Cycle {
  parentCourseId String
  parentCourse Course @relation(fields: [parentCourseId], references: [id], onDelete: Restrict)
  cycleNumber Int

  id           String   @id @default(uuid())
  name         String
  venue        String?
  classStartTime String? // Local class time HH:mm
  classEndTime   String? // Local class time HH:mm
  details      String?
  branch       String
  startDate    DateTime?
  endDate      DateTime?
  isFinished   Boolean  @default(false)
  totalHours   Float?   // Set when course is created or finished
  courseFee    Float    @default(0) // Standard tuition fee in EGP
  payrollMonth String?  // Legacy migration-only; current earnings have no payroll month.
  isPaid       Boolean  @default(false) // Legacy migration-only; use earning batches. 
  archivedAt   DateTime?
  archivedBy   String?
  payrollRecord PayrollRecord?
  payrollEarnings PayrollEarning[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructors  CourseInstructor[]
  pendingAssignments PendingAssignment[]
  enrollments  Enrollment[]

  @@unique([parentCourseId, cycleNumber])
  @@index([parentCourseId, archivedAt])
}

model CourseInstructor {
  id           String     @id @default(uuid())
  courseId     String
  instructorId String
  hourlyRate   Float      // The specific rate for this instructor in this course
  hoursTaught  Float?     // Filled when course is finished
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course       Cycle     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId])
}

model PendingAssignment {
  id              String   @id @default(uuid())
  courseId        String
  instructorId    String?  // null if requesting removal
  submittedById   String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  type            String   @default("ASSIGN")  // ASSIGN, REMOVE
  replacedAssignmentId String?
  replacedInstructorId String?
  resolvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Cycle      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor      Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  submittedBy     User        @relation("SubmittedAssignments", fields: [submittedById], references: [id], onDelete: Cascade)
  resolvedBy      User?       @relation("ResolvedAssignments", fields: [resolvedById], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Recipient
  title       String
  message     String
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedBy  String?  // Name of the mod/admin who resolved it
  type        String   // 'ASSIGNMENT_REQUEST', 'ASSIGNMENT_APPROVED', 'ASSIGNMENT_REJECTED'
  relatedId   String?  // ID of the PendingAssignment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BranchColor {
  name  String @id
  color String
}

model Student {
  id                 String       @id @default(uuid())
  name               String
  englishName        String?
  dateOfBirth        DateTime?
  nationality        String?
  placeOfBirth       String?
  registrationNumber String       @unique
  mobile             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  deletedBy          String?

  enrollments        Enrollment[]
}

model Enrollment {
  id         String   @id @default(uuid())
  courseId   String
  studentId  String
  amountPaid Float    @default(0)
  customFee  Float?   // If set, overrides course courseFee for this student (0 = exempt / scholarship)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookPayments BookPayment[]
  payments   PaymentEntry[]
  deletedAt  DateTime?
  deletedBy  String?
  financialArchivedAt DateTime?

  course     Cycle   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// Legacy snapshots retained for migration and historical compatibility only.
// Current payroll uses PayrollEarning and InstructorPaymentBatch.
model PayrollRecord {
  id           String @id @default(uuid())
  courseId     String @unique
  course       Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name         String
  branch       String
  totalHours   Float
  payrollMonth String?
  isPaid       Boolean @default(false)
  instructors  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([payrollMonth])
}

// Immutable tuition ledger. Amounts are signed integer piasters, never floating-point cash.
// Historical snapshots survive enrollment removal; correcting an entry adds another entry.
model PaymentEntry {
  id                String   @id @default(uuid())
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseId          String
  studentId         String
  courseName        String
  studentName       String
  amountMinor       BigInt
  kind              String
  note              String
  recordedBy        String
  recordedAt        DateTime @default(now())
  occurredAt        DateTime @default(now())
  idempotencyKey    String   @unique
  paymentMethod     String   @default("UNSPECIFIED")
  receiptNumber     String?
  paymentDateKnown  Boolean  @default(true)
  importBatchId     String?
  reversalOfId      String?  @unique
  reversalOf        PaymentEntry? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal          PaymentEntry? @relation("PaymentReversal")

  @@index([enrollmentId, recordedAt])
  @@index([courseId, occurredAt])
  @@index([studentId])
}


// Successful imports only. Source workbooks are not retained.
model ImportBatch {
  id String @id @default(uuid())
  fingerprint String @unique
  fileName String
  parentCourseId String
  cycleId String @unique
  recordedBy String
  createdAt DateTime @default(now())
  studentCount Int
}

// Durable approval history. Scalar target IDs and snapshots survive target deletion.
model StudentRequest {
  id String @id @default(uuid())
  action String
  status String @default("PENDING")
  submittedById String
  resolvedById String?
  studentId String?
  courseId String?
  enrollmentId String?
  payload String
  snapshot String
  pendingKey String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
  @@index([submittedById, createdAt])
}

model PayrollEarning {
  id String @id @default(uuid())
  courseId String
  course Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorId String
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  cycleName String
  branch String
  instructorName String
  employeeId String?
  hours Float
  rate Float
  amountMinor BigInt
  batchId String?
  batch InstructorPaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([courseId, instructorId])
  @@index([instructorId, batchId])
}
model InstructorPaymentBatch {
  id String @id @default(uuid())
  instructorId String
  instructorName String
  status String @default("PROCESSING")
  initiatedDate DateTime?
  actualPaymentDate DateTime?
  initiatedBy String?
  paidBy String?
  legacy Boolean @default(false)
  idempotencyKey String? @unique
  earnings PayrollEarning[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, initiatedDate])
}

// Immutable purchase-time amounts; undo retains the original record.
model BookPayment {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activeKey String? @unique
  status String
  amountMinor BigInt
  recordedAt DateTime @default(now())
  recordedBy String
  reversedAt DateTime?
  reversedBy String?
  @@index([enrollmentId])
}
