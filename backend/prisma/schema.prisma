generator client {
  provider = "prisma-client-js"
  output = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String?
  role      String   @default("user") // 'user', 'mod', 'admin'
  email     String?
  firstName String?
  lastName  String?
  avatar    String?
  isActive  Boolean  @default(true)
  isBanned  Boolean  @default(false)
  lastLogin DateTime?
  canManageBooks Boolean @default(false)
  // Mods only: null = main mod (all branches, payroll); a branch (e.g. FOUAD) = branch mod whose money is checked.
  branchScope String?
  // Users (role "user") see only these branches (comma-separated); none means nothing until assigned.
  branches String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  submittedAssignments PendingAssignment[] @relation("SubmittedAssignments")
  resolvedAssignments  PendingAssignment[] @relation("ResolvedAssignments")
  notifications        Notification[]
}

model SystemLog {
  id             String   @id @default(uuid())
  action         String
  description    String
  actorUsername  String
  targetUsername String?
  createdAt      DateTime @default(now())

  actorId        String?
  actorRole      String?
  authMethod     String?
  category       String   @default("system")
  outcome        String   @default("SUCCESS")
  requestId      String?  @unique
  statusCode     Int?
  durationMs     Int?
  recordCount    Int      @default(0)
  details        Json?

  @@index([createdAt, id])
  @@index([actorRole, createdAt])
  @@index([actorUsername, createdAt])
  @@index([category, outcome, createdAt])
}

model Instructor {
  id         String   @id @default(uuid())
  name       String
  branches   String   // Stored as a comma-separated string (e.g., "MIAMI,FOUAD")
  employeeId String? @unique  // Employee ID
  mobile     String?  // Mobile Number
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  archivedAt DateTime?
  archivedBy String?
  payrollEarnings PayrollEarning[]
  courseAssignments  CourseInstructor[]
  pendingAssignments PendingAssignment[]
}

// Umbrella: no branch, teaching defaults, enrollment, or financial state.
model Course {
  isPrivate Boolean @default(false)
  id String @id @default(uuid())
  name String
  code String @unique
  bookPrice Float @default(0)
  // Branches allowed to run cycles under this umbrella (comma-separated). New umbrellas open for Miami only.
  branches String @default("MIAMI")
  archivedAt DateTime?
  archivedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cycles Cycle[]
  subCourses SubCourse[]
}

// Private umbrellas only: an organizing level (e.g. KET, PET) between the umbrella and its cycles.
// Money stays on cycles; the sub-umbrella supplies cycle names, numbering and the book price.
model SubCourse {
  id             String    @id @default(uuid())
  parentCourseId String
  parentCourse   Course    @relation(fields: [parentCourseId], references: [id], onDelete: Restrict)
  name           String
  bookPrice      Float     @default(0)
  archivedAt     DateTime?
  archivedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cycles         Cycle[]

  @@unique([parentCourseId, name])
}

model Cycle {
  parentCourseId String
  parentCourse Course @relation(fields: [parentCourseId], references: [id], onDelete: Restrict)
  // Private cycles belong to a sub-umbrella; group cycles do not.
  subCourseId String?
  subCourse SubCourse? @relation(fields: [subCourseId], references: [id], onDelete: Restrict)
  // The umbrella (group) or sub-umbrella (private) the cycle is named after.
  numberingKey String
  // The level the mod enters (1 and up). Name: "<umbrella> <level> - <start month> <year>", plus " (n)" when the
  // same branch already runs that level in that month (sequence n).
  cycleNumber Int
  sequence    Int @default(1)
  // Levels taken one after another (KET 1 -> KET 2): same umbrella or sub-umbrella and same branch.
  // chainId is the first cycle of the chain and chainStart its start date, so a chain lists together.
  previousCycleId String?
  previousCycle   Cycle?  @relation("NextLevel", fields: [previousCycleId], references: [id], onDelete: SetNull)
  nextCycles      Cycle[] @relation("NextLevel")
  chainId         String?
  chainStart      DateTime?

  id           String   @id @default(uuid())
  name         String
  venue        String?
  classStartTime String? // Local class time HH:mm
  classEndTime   String? // Local class time HH:mm
  details      String?
  branch       String
  startDate    DateTime?
  endDate      DateTime?
  isFinished   Boolean  @default(false)
  totalHours   Float?   // Set when course is created or finished
  courseFee    Float    @default(0) // Standard tuition fee in EGP
  payrollMonth String?  // Legacy migration-only; current earnings have no payroll month.
  isPaid       Boolean  @default(false) // Legacy migration-only; use earning batches. 
  archivedAt   DateTime?
  archivedBy   String?
  payrollRecord PayrollRecord?
  payrollEarnings PayrollEarning[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructors  CourseInstructor[]
  pendingAssignments PendingAssignment[]
  retainedIncome RetainedEnrollmentIncome[]
  enrollments  Enrollment[]

  @@unique([numberingKey, branch, name])
  @@index([parentCourseId, archivedAt])
  @@index([subCourseId])
  @@index([chainId])
}

model CourseInstructor {
  id           String     @id @default(uuid())
  courseId     String
  instructorId String
  hourlyRate   Float      // The specific rate for this instructor in this course
  hoursTaught  Float?     // Filled when course is finished
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course       Cycle     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([courseId, instructorId])
}

model PendingAssignment {
  id              String   @id @default(uuid())
  courseId        String
  instructorId    String?  // null if requesting removal
  submittedById   String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  type            String   @default("ASSIGN")  // ASSIGN, REMOVE
  replacedAssignmentId String?
  replacedInstructorId String?
  resolvedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course          Cycle      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor      Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  submittedBy     User        @relation("SubmittedAssignments", fields: [submittedById], references: [id], onDelete: Cascade)
  resolvedBy      User?       @relation("ResolvedAssignments", fields: [resolvedById], references: [id], onDelete: SetNull)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String   // Recipient
  title       String
  message     String
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  resolvedBy  String?  // Name of the mod/admin who resolved it
  type        String   // 'ASSIGNMENT_REQUEST', 'ASSIGNMENT_APPROVED', 'ASSIGNMENT_REJECTED'
  relatedId   String?  // ID of the PendingAssignment
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BranchColor {
  name  String @id
  color String
}

model Student {
  id                 String       @id @default(uuid())
  name               String
  englishName        String?
  dateOfBirth        DateTime?
  nationality        String?
  placeOfBirth       String?
  registrationNumber String?      @unique
  mobile             String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?
  deletedBy          String?

  enrollments        Enrollment[]
}

model Enrollment {
  id         String   @id @default(uuid())
  courseId   String
  studentId  String
  amountPaid Float    @default(0)
  customFee  Float?   // If set, overrides course courseFee for this student (0 = exempt / scholarship)
  enrolledAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  bookPayments BookPayment[]
  payments   PaymentEntry[]
  deletedAt  DateTime?
  deletedBy  String?
  financialArchivedAt DateTime?

  course     Cycle   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

// Legacy snapshots retained for migration and historical compatibility only.
// Current payroll uses PayrollEarning and InstructorPaymentBatch.
model PayrollRecord {
  id           String @id @default(uuid())
  courseId     String @unique
  course       Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  name         String
  branch       String
  totalHours   Float
  payrollMonth String?
  isPaid       Boolean @default(false)
  instructors  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([payrollMonth])
}

// Immutable tuition ledger. Amounts are signed integer piasters, never floating-point cash.
// Historical snapshots survive enrollment removal; correcting an entry adds another entry.
model PaymentEntry {
  id                String   @id @default(uuid())
  enrollmentId      String?
  enrollment        Enrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  courseId          String
  studentId         String
  courseName        String
  studentName       String
  amountMinor       BigInt
  kind              String
  note              String
  recordedBy        String
  recordedAt        DateTime @default(now())
  occurredAt        DateTime @default(now())
  idempotencyKey    String   @unique
  paymentMethod     String   @default("UNSPECIFIED")
  receiptNumber     String?
  paymentDateKnown  Boolean  @default(true)
  importBatchId     String?
  reversalOfId      String?  @unique
  reversalOf        PaymentEntry? @relation("PaymentReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversal          PaymentEntry? @relation("PaymentReversal")

  @@index([enrollmentId, recordedAt])
  @@index([courseId, occurredAt])
  @@index([studentId])
}


// Successful imports only. Source workbooks are not retained.
model ImportBatch {
  id String @id @default(uuid())
  fingerprint String @unique
  fileName String
  parentCourseId String
  cycleId String @unique
  recordedBy String
  createdAt DateTime @default(now())
  studentCount Int
}

model PayrollEarning {
  isPrivate Boolean @default(false)
  id String @id @default(uuid())
  courseId String
  course Cycle @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorId String
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  cycleName String
  branch String
  instructorName String
  employeeId String?
  hours Float
  rate Float
  amountMinor BigInt
  batchId String?
  batch InstructorPaymentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([courseId, instructorId])
  @@index([instructorId, batchId])
}
// A payment batch as staff see it: "Payment batch 2 · October 2026". One initiation creates one run;
// numbers restart each initiation month and are never reused. Each employee's payment inside it is an
// InstructorPaymentBatch with its own status and actual payment date.
model PaymentRun {
  id String @id @default(uuid())
  year Int
  month Int
  number Int
  initiatedDate DateTime
  initiatedBy String?
  payments InstructorPaymentBatch[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([year, month, number])
}

model InstructorPaymentBatch {
  id String @id @default(uuid())
  runId String
  run PaymentRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  instructorId String
  instructorName String
  status String @default("PROCESSING")
  initiatedDate DateTime?
  actualPaymentDate DateTime?
  initiatedBy String?
  paidBy String?
  legacy Boolean @default(false)
  idempotencyKey String? @unique
  earnings PayrollEarning[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, initiatedDate])
  @@index([runId])
}

// Immutable purchase-time amounts; undo retains the original record.
model BookPayment {
  id String @id @default(uuid())
  enrollmentId String
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  activeKey String? @unique
  status String
  amountMinor BigInt
  recordedAt DateTime @default(now())
  recordedBy String
  reversedAt DateTime?
  reversedBy String?
  @@index([enrollmentId])
}

model RetainedEnrollmentIncome {
 id String @id @default(uuid())
 courseId String
 course Cycle @relation(fields:[courseId],references:[id],onDelete:Cascade)
 sourceEnrollmentId String @unique
 tuitionMinor BigInt
 bookMinor BigInt
 reason String
 snapshot Json
 recordedBy String
 createdAt DateTime @default(now())
 @@index([courseId])
}

// A main mod's (or admin's) confirmation that money recorded for a checked branch matches the paperwork.
// kind: PAYMENT (tuition ledger entry) or BOOK (book payment). The fingerprint captures the record when checked,
// so a later change shows as "changed after check".
model MoneyCheck {
  id          String   @id @default(uuid())
  kind        String
  recordId    String
  branch      String
  fingerprint String
  note        String?
  checkedBy   String
  checkedAt   DateTime @default(now())

  @@unique([kind, recordId])
  @@index([branch])
}
