{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd backend && npm ci && cd ../frontend && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/{demo/demo.db,node_modules/.prisma/client/**}",
      "maxDuration": 60
    }
  },
  "env": {
    "VERCEL_SQLITE_DEMO": "1",
    "NODE_ENV": "production"
  },
  "rewrites": [
    {
      "source": "/api/:route*",
      "destination": "/api/index?__route=:route*"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
